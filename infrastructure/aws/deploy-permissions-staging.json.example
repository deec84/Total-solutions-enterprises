{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AuthenticateToEcr",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushOnlyToStagingRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:CompleteLayerUpload",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": "arn:aws:ecr:<AWS_REGION>:<STAGING_AWS_ACCOUNT_ID>:repository/<STAGING_ECR_REPOSITORY_NAME>"
    },
    {
      "Sid": "RegisterTaskDefinition",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTaskDefinition",
        "ecs:RegisterTaskDefinition"
      ],
      "Resource": "*"
    },
    {
      "Sid": "OperateOnlyStagingService",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices",
        "ecs:UpdateService"
      ],
      "Resource": "arn:aws:ecs:<AWS_REGION>:<STAGING_AWS_ACCOUNT_ID>:service/<STAGING_CLUSTER_NAME>/<STAGING_SERVICE_NAME>"
    },
    {
      "Sid": "RunOnlyParkShieldMigrationTasks",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:<AWS_REGION>:<STAGING_AWS_ACCOUNT_ID>:task-definition/<STAGING_TASK_FAMILY>:*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:<AWS_REGION>:<STAGING_AWS_ACCOUNT_ID>:cluster/<STAGING_CLUSTER_NAME>"
        }
      }
    },
    {
      "Sid": "ObserveOnlyStagingMigrationTasks",
      "Effect": "Allow",
      "Action": "ecs:DescribeTasks",
      "Resource": "arn:aws:ecs:<AWS_REGION>:<STAGING_AWS_ACCOUNT_ID>:task/<STAGING_CLUSTER_NAME>/*"
    },
    {
      "Sid": "PassOnlyParkShieldTaskRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::<STAGING_AWS_ACCOUNT_ID>:role/<STAGING_ECS_EXECUTION_ROLE_NAME>",
        "arn:aws:iam::<STAGING_AWS_ACCOUNT_ID>:role/<STAGING_ECS_TASK_ROLE_NAME>"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
